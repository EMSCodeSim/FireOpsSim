+}
+.patient-finding-chip.abnormal{
+  border-color:#d99b19;
+  background:rgba(70,48,12,.92);
+  color:#ffe3a3;
+}
+@keyframes assessmentChipIn{
+  from{opacity:0;transform:translateY(6px)}
+  to{opacity:1;transform:translateY(0)}
+}
+
+.assessment-decision-progress{
+  margin:8px 0;
+  padding:10px 11px;
+  border:1px solid #31566d;
+  border-radius:13px;
+  background:#0b2231;
+  color:#d6e4ec;
+}
+.assessment-decision-progress[hidden]{display:none!important}
+.assessment-decision-progress>header{
+  display:flex;
+  align-items:flex-end;
+  justify-content:space-between;
+  gap:10px;
+  margin-bottom:8px;
+}
+.assessment-decision-progress>header small{
+  display:block;
+  color:#7fd0ff;
+  font-size:.58rem;
+  font-weight:900;
+  letter-spacing:.09em;
+}
+.assessment-decision-progress>header strong{
+  display:block;
+  margin-top:2px;
+  color:#fff;
+  font-size:.88rem;
+}
+.assessment-decision-progress>header span{
+  flex:0 0 auto;
+  min-width:42px;
+  padding:5px 8px;
+  border-radius:999px;
+  background:#173f5a;
+  color:#fff;
+  font-size:.68rem;
+  font-weight:900;
+  text-align:center;
+}
+.assessment-discovered-summary{
+  margin:0 0 8px;
+  padding:8px 9px;
+  border-radius:10px;
+  background:#10283a;
+  font-size:.72rem;
+  line-height:1.4;
+  color:#b8cad7;
+}
+.assessment-discovered-summary b{color:#eef8fd}
+.assessment-req-list{
+  display:grid;
+  gap:5px;
+  margin:0;
+  padding:0;
+  list-style:none;
+}
+.assessment-req-list li{
+  display:grid;
+  grid-template-columns:22px minmax(0,1fr);
+  gap:8px;
+  align-items:start;
+  padding:7px 8px;
+  border-radius:9px;
+  background:#10283a;
+  font-size:.72rem;
+  line-height:1.35;
+}
+.assessment-req-list li mark{
+  display:grid;
+  place-items:center;
+  width:18px;
+  height:18px;
+  margin-top:1px;
+  border-radius:50%;
