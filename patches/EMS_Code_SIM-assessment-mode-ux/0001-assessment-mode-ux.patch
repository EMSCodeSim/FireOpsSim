+    if (abnormal.length && !chips.dataset.seeded) chips.dataset.seeded = '1';
+  }
+
+  /* ---------- Decision progress checklist ---------- */
+
+  function ensureDecisionProgress() {
+    if ($('assessmentDecisionProgress')) return;
