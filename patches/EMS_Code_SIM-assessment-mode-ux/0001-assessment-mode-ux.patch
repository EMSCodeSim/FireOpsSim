+/* Assessment Mode UX — onboarding, hotspots, progress, mobile polish */
+
+.assessment-mode-banner{
+  position:relative;
+  z-index:28;
+  display:grid;
+  gap:8px;
+  margin:0 0 8px;
+  padding:11px 12px;
+  border:1px solid #3d7ea3;
+  border-radius:14px;
+  background:linear-gradient(135deg,#0d2a3d,#12384f 55%,#0f3146);
+  color:#e8f4fb;
+  box-shadow:0 10px 24px rgba(0,0,0,.22);
+}
+.assessment-mode-banner[hidden]{display:none!important}
+.assessment-mode-banner-head{
+  display:flex;
+  align-items:flex-start;
+  justify-content:space-between;
+  gap:10px;
+}
+.assessment-mode-banner-head small{
+  display:block;
+  font-size:.58rem;
+  font-weight:900;
+  letter-spacing:.1em;
+  color:#7fd0ff;
+}
+.assessment-mode-banner-head strong{
+  display:block;
+  margin-top:2px;
+  font-size:.92rem;
+  line-height:1.25;
+}
+.assessment-mode-banner-dismiss{
+  flex:0 0 auto;
+  min-width:44px;
+  min-height:44px;
+  border:1px solid #4b8caf;
+  border-radius:11px;
+  background:#173f5a;
+  color:#fff;
+  font:inherit;
+  font-weight:850;
+  cursor:pointer;
+}
+.assessment-mode-banner-steps{
+  display:flex;
+  flex-wrap:wrap;
+  gap:6px;
+  align-items:center;
+  font-size:.74rem;
+  line-height:1.35;
+  color:#c5dbe8;
+}
+.assessment-mode-banner-steps b{color:#fff}
+.assessment-mode-banner-steps .step-arrow{opacity:.55;font-weight:700}
+
+.assessment-flow-rail{
+  display:grid;
+  grid-template-columns:repeat(4,minmax(0,1fr));
+  gap:5px;
+  margin:0 0 8px;
+  padding:6px;
+  border:1px solid #31566d;
+  border-radius:13px;
+  background:#0a1f2e;
+}
+.assessment-flow-rail[hidden]{display:none!important}
+.assessment-flow-step{
+  appearance:none;
+  display:grid;
+  gap:2px;
+  min-height:44px;
+  padding:7px 6px;
+  border:1px solid transparent;
+  border-radius:10px;
+  background:transparent;
+  color:#9bb4c4;
+  text-align:center;
+  font:inherit;
+  cursor:pointer;
+  transition:background .2s,border-color .2s,color .2s,transform .2s;
+}
+.assessment-flow-step small{
+  font-size:.52rem;
+  font-weight:900;
+  letter-spacing:.08em;
+}
+.assessment-flow-step strong{
+  font-size:.68rem;
+  line-height:1.15;
+}
+.assessment-flow-step.is-current{
+  border-color:#67b9df;
+  background:#154867;
+  color:#fff;
+  box-shadow:0 0 0 1px rgba(103,185,223,.25);
+  transform:translateY(-1px);
+}
+.assessment-flow-step.is-done{
+  border-color:#3f8f6d;
+  background:#103a35;
+  color:#b7ead4;
+}
+.assessment-flow-step:focus-visible{
+  outline:2px solid #7fd0ff;
+  outline-offset:2px;
+}
+
+.patient-hotspot-layer{
+  position:absolute;
+  inset:0;
+  z-index:4;
+  pointer-events:none;
+}
+.patient-hotspot{
+  position:absolute;
+  pointer-events:auto;
+  min-width:44px;
+  min-height:44px;
+  border:1.5px solid rgba(127,208,255,.35);
+  border-radius:999px;
+  background:rgba(18,72,102,.18);
+  color:transparent;
+  font:inherit;
+  cursor:pointer;
+  touch-action:manipulation;
+  -webkit-tap-highlight-color:transparent;
+  transition:background .18s,border-color .18s,box-shadow .18s,transform .18s;
+}
+.patient-hotspot::after{
+  content:attr(data-label);
+  position:absolute;
+  left:50%;
+  bottom:calc(100% + 6px);
+  transform:translateX(-50%) translateY(4px);
+  padding:4px 8px;
+  border-radius:8px;
+  background:rgba(6,19,31,.94);
+  color:#e8f4fb;
+  font-size:.62rem;
+  font-weight:850;
+  white-space:nowrap;
+  opacity:0;
+  pointer-events:none;
+  transition:opacity .15s,transform .15s;
+}
+.patient-hotspot:hover,
+.patient-hotspot:focus-visible,
+.patient-hotspot.is-active{
+  background:rgba(79,179,255,.28);
+  border-color:#7fd0ff;
+  box-shadow:0 0 0 3px rgba(127,208,255,.2);
+  transform:scale(1.04);
+}
+.patient-hotspot:hover::after,
+.patient-hotspot:focus-visible::after,
+.patient-hotspot.is-active::after{
+  opacity:1;
+  transform:translateX(-50%) translateY(0);
+}
+.patient-hotspot.is-assessed{
+  border-color:#5fcf98;
+  background:rgba(46,148,109,.28);
+}
+.patient-hotspot.is-assessed::before{
+  content:'✓';
+  position:absolute;
+  right:-2px;
+  top:-2px;
+  display:grid;
+  place-items:center;
+  width:18px;
+  height:18px;
+  border-radius:50%;
+  background:#1f7a55;
+  color:#fff;
+  font-size:.65rem;
+  font-weight:900;
+  line-height:1;
+  box-shadow:0 2px 6px rgba(0,0,0,.35);
+}
+.patient-hotspot-chip-row{
+  position:absolute;
+  left:8px;
+  right:8px;
+  bottom:8px;
+  z-index:5;
+  display:flex;
+  flex-wrap:wrap;
+  gap:5px;
+  pointer-events:none;
+}
+.patient-finding-chip{
+  display:inline-flex;
+  align-items:center;
+  gap:4px;
+  max-width:100%;
+  padding:4px 8px;
+  border-radius:999px;
+  border:1px solid #3f8f6d;
+  background:rgba(16,58,53,.92);
+  color:#d7f5e7;
+  font-size:.62rem;
+  font-weight:850;
+  line-height:1.2;
