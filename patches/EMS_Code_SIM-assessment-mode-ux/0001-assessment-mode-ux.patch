+  }
+
+  function nextLockedDecision(r, decisions) {
+    return decisions.find(decision => !decisionUnlocked(r, decision) && !r?.documentation?.reasoningDecisions?.[decision.id]) || null;
+  }
+
+  function refreshDecisionProgress(r) {
